# AuronOrigin | Vorlage. Auf JEDEM Rechner als .env speichern, nur die dort
# benoetigten Werte muessen gesetzt werden. KEINE Leerzeichen um das "=".
# ---------------------------------------------------------------------------
# Dell (Worker + Ollama)  -> ~/AuronOrigin/.env
WORKER_TOKEN=HIER_LANGEN_ZUFALLSSTRING_EINTRAGEN
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_FAST_MODEL=llama3.2:3b
OLLAMA_NUM_THREADS=10
# ---------------------------------------------------------------------------
# 24/7-Laptop (n8n) -> ~/AuronOrigin/n8n/.env
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# WEBHOOK_URL=http://localhost:5678/
# Mit Cloudflare-Tunnel spaeter: N8N_HOST=n8n.auronorigin.world,
# N8N_PROTOCOL=https, WEBHOOK_URL=https://n8n.auronorigin.world/
# ---------------------------------------------------------------------------
# Inhalt
CONTENT_LANG=en
TARGET_SECONDS=70
# ---------------------------------------------------------------------------
# Optionale Gratis-APIs: LEER LASSEN = Pipeline laeuft trotzdem (RSS + gemalte Karten)
BRAVE_API_KEY=
PEXELS_API_KEY=
# ---------------------------------------------------------------------------
# Stimme: edge (kostenlos, online) -> piper -> espeak-ng (offline) als Fallback
TTS_ENGINE=edge
TTS_VOICE_EN=en-US-GuyNeural
TTS_VOICE_DE=de-DE-KatjaNeural
PIPER_MODEL_EN=
PIPER_MODEL_DE=
# ---------------------------------------------------------------------------
# Optional: Telegram-Push (Bonus-Phase), sonst leer lassen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ---------------------------------------------------------------------------
# Pfade (leer lassen = ~/AuronOrigin)
AU_HOME=
